# Project options, read by every R session blogdown starts to knit a page.
# A personal ~/.Rprofile is read first, so it still applies.
if (file.exists("~/.Rprofile")) {
  sys.source("~/.Rprofile", envir = environment())
}

# Knitted output is wrapped at this many characters. 100 keeps a coda summary
# -- Mean, SD, Naive SD, Time-series SD and the three quantiles, 96 characters
# plus knitr's "## " -- on one line, and fits a code block at the font size
# static/css/site.css sets.
options(width = 100)
